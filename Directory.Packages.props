<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!-- Enable Central Package Management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <!-- ==================== INTERNAL DEPENDENCIES ==================== -->
  <ItemGroup>
    <PackageVersion Include="Plugin.ByteArrays" Version="1.0.36" />
    <PackageVersion Include="Plugin.ExceptionListeners" Version="1.0.10" />
    <PackageVersion Include="Plugin.BaseTypeExtensions" Version="1.0.32" />
    <PackageVersion Include="Plugin.ExceptionListeners.Maui" Version="1.0.10" />
  </ItemGroup>
  <!-- ==================== CORE DEPENDENCIES ==================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
  </ItemGroup>
  <!-- ==================== MAUI DEPENDENCIES ==================== -->
  <PropertyGroup>
    <!-- MAUI version - update this single value to upgrade MAUI across all projects -->
    <MauiVersion>10.0.41</MauiVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Microsoft.Maui.Core" Version="$(MauiVersion)" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageVersion Include="Microsoft.Maui.Essentials" Version="$(MauiVersion)" />
  </ItemGroup>
  <!-- ==================== COMMUNITY DEPENDENCIES ==================== -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="CommunityToolkit.Maui" Version="15.0.1" />
  </ItemGroup>
  <!-- ==================== TEST DEPENDENCIES ==================== -->
  <ItemGroup>
    <!-- FluentAssertions versions 8+ are free for open source projects                -->
    <!-- and non commercial use but commercial use requires a paid license             -->
    <!--                                                                               -->
    <!-- Version 7 will remain fully open source indefinitely and receive              -->
    <!-- bugfixes and other important corrections                                      -->
    <PackageVersion Include="FluentAssertions" Version="7.2.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="coverlet.msbuild" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
  <!-- ==================== BUILD & ANALYSIS DEPENDENCIES ==================== -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.401" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.401" />
  </ItemGroup>
  <!-- ==================== LOGGING DEPENDENCIES ==================== -->
  <ItemGroup>
    <PackageVersion Include="JetBrains.Annotations" Version="2026.2.0" />
    <PackageVersion Include="NLog.Extensions.Logging" Version="6.2.1" />
    <PackageVersion Include="NLog.Targets.MauiLog" Version="10.2.1" />
  </ItemGroup>
</Project>